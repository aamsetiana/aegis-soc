# AegisSOC Environment Variables Example
# Copy this file to .env and fill in the values. NEVER commit .env to version control!

# Database connection (PostgreSQL - Neon / Supabase / Local)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.region.neon.tech/aegissoc?sslmode=require"

# JWT Secret for Session Management (Generate using `openssl rand -hex 32`)
JWT_SECRET="replace-with-a-very-long-and-secure-random-secret-key-at-least-32-chars"

# Node Environment
NODE_ENV="development"

# App Public URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

